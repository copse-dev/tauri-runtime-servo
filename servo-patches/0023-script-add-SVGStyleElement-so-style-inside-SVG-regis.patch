+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+use std::sync::atomic::AtomicBool;
+
+use dom_struct::dom_struct;
+use html5ever::{LocalName, Prefix, local_name};
+use js::context::JSContext;
+use js::rust::HandleObject;
+use script_bindings::cell::DomRefCell;
+use script_bindings::root::Dom;
+use servo_arc::Arc;
+use style::media_queries::MediaList as StyleMediaList;
+use style::stylesheets::{
+    AllowImportRules, Origin, Stylesheet, StylesheetContents, UrlExtraData,
+};
+use stylo_dom::ElementState;
+
+use crate::dom::bindings::codegen::Bindings::NodeBinding::NodeMethods;
+use crate::dom::bindings::inheritance::Castable;
+use crate::dom::bindings::root::DomRoot;
+use crate::dom::csp::{CspReporting, InlineCheckType};
+use crate::dom::document::Document;
+use crate::dom::element::attributes::storage::AttrRef;
+use crate::dom::element::{AttributeMutation, Element};
+use crate::dom::documentorshadowroot::StylesheetSource;
+use crate::dom::node::virtualmethods::VirtualMethods;
+use crate::dom::node::{BindContext, ChildrenMutation, Node, NodeTraits, UnbindContext};
+use crate::dom::svg::svgelement::SVGElement;
+
+/// <https://svgwg.org/svg2-draft/styling.html#StyleElement>
+///
+/// The part of `HTMLStyleElement` a `<style>` inside an `<svg>` actually
+/// needs: parse the text content, register the sheet, keep it current across
+/// mutations. No CSSOM `sheet` accessor, no `media`/`type` reflection, no
+/// render-blocking — none of which change whether the rules cascade.
+///
+/// This existing at all is what makes stylesheet-driven SVG content work when
+/// the sheet ships *inside* the SVG, which is how Mermaid ships its theme:
+/// without it the tag fell back to a bare `SVGElement`, the sheet never
+/// registered, and every themed diagram painted with initial values — black
+/// shapes, invisible strokes.
+#[dom_struct]
+pub(crate) struct SVGStyleElement {
+    svgelement: SVGElement,
+    #[conditional_malloc_size_of]
+    #[no_trace]
+    stylesheet: DomRefCell<Option<Arc<Stylesheet>>>,
+}
+
+impl SVGStyleElement {
+    fn new_inherited(
+        local_name: LocalName,
+        prefix: Option<Prefix>,
+        document: &Document,
+    ) -> SVGStyleElement {
+        SVGStyleElement {
+            svgelement: SVGElement::new_inherited_with_state(
+                ElementState::empty(),
+                local_name,
+                prefix,
+                document,
+            ),
+            stylesheet: DomRefCell::new(None),
+        }
+    }
+
+    pub(crate) fn new(
+        cx: &mut JSContext,
+        local_name: LocalName,
+        prefix: Option<Prefix>,
+        document: &Document,
+        proto: Option<HandleObject>,
+    ) -> DomRoot<SVGStyleElement> {
+        Node::reflect_node_with_proto(
+            cx,
+            Box::new(SVGStyleElement::new_inherited(local_name, prefix, document)),
+            document,
+            proto,
+        )
+    }
+
+    /// The SVG equivalent of HTML's "update a style block".
+    fn update_style_block(&self, cx: &mut JSContext) {
+        self.remove_stylesheet();
+
+        let node = self.upcast::<Node>();
+        if !node.is_connected() {
+            return;
+        }
+
+        // A `type` other than the empty string or `text/css` leaves the sheet
+        // unprocessed, same as HTML's update-a-style-block step 4.
+        if let Some(type_value) = self
+            .upcast::<Element>()
+            .get_attribute_string_value(&local_name!("type")) &&
+            !type_value.is_empty() &&
+            !type_value.eq_ignore_ascii_case("text/css")
+        {
+            return;
+        }
+
+        // The inline CSP check is kept even though everything else optional
+        // was dropped: a `<style>` arriving inside SVG markup is exactly the
+        // kind of content a policy means to constrain.
+        let doc = self.owner_document();
+        let global = &self.owner_global();
+        if global
+            .get_csp_list()
+            .should_elements_inline_type_behavior_be_blocked(
+                cx,
+                global,
+                self.upcast(),
+                InlineCheckType::Style,
+                &node.child_text_content().str(),
+                doc.get_current_parser_line(),
+            )
+        {
+            return;
+        }
+
+        // Parsed directly rather than through `StylesheetContentsCache`,
+        // whose loader plumbing is typed to `HTMLElement`. The cost is
+        // re-parsing identical sheets; `@import` inside SVG styles is not
+        // loaded, which matches how rare it is in the wild.
+        let data = node
+            .GetTextContent()
+            .expect("Element.textContent must be a string");
+        let shared_lock = node.owner_doc().style_shared_author_lock().clone();
+        let contents = StylesheetContents::from_str(
+            &data.str(),
+            UrlExtraData(doc.base_url().get_arc()),
+            Origin::Author,
+            &shared_lock,
+            None, /* stylesheet_loader */
+            Some(self.owner_window().css_error_reporter()),
+            doc.quirks_mode(),
+            AllowImportRules::No,
+            None, /* sanitized_output */
+        );
+        let media = Arc::new(shared_lock.wrap(StyleMediaList::empty()));
+        let sheet = Arc::new(Stylesheet {
+            contents: shared_lock.wrap(contents),
+            shared_lock,
+            media,
+            disabled: AtomicBool::new(false),
+        });
+
+        *self.stylesheet.borrow_mut() = Some(sheet.clone());
+        self.stylesheet_list_owner()
+            .add_owned_stylesheet(self.upcast(), sheet);
+    }
+
+    fn remove_stylesheet(&self) {
+        if let Some(sheet) = self.stylesheet.borrow_mut().take() {
+            self.stylesheet_list_owner().remove_stylesheet(
+                StylesheetSource::Element(Dom::from_ref(self.upcast())),
+                &sheet,
+            );
+        }
+    }
+}
+
+impl VirtualMethods for SVGStyleElement {
+    fn super_type(&self) -> Option<&dyn VirtualMethods> {
+        Some(self.upcast::<SVGElement>() as &dyn VirtualMethods)
+    }
+
+    // Unlike HTMLStyleElement there is no "on the stack of open elements"
+    // tracking: the SVG element factory does not carry an `ElementCreator`.
+    // The consequence is one wasted parse when the parser binds the element
+    // before its text children exist — `children_changed` then reparses with
+    // the real content, so the end state is the same.
+    fn children_changed(&self, cx: &mut JSContext, mutation: &ChildrenMutation) {
+        self.super_type().unwrap().children_changed(cx, mutation);
+        self.update_style_block(cx);
+    }
+
+    fn bind_to_tree(&self, cx: &mut JSContext, context: &BindContext) {
+        self.super_type().unwrap().bind_to_tree(cx, context);
+        self.update_style_block(cx);
+    }
+
+    fn pop(&self, cx: &mut JSContext) {
+        self.super_type().unwrap().pop(cx);
+        self.update_style_block(cx);
+    }
+
+    fn unbind_from_tree(&self, cx: &mut JSContext, context: &UnbindContext) {
+        self.super_type().unwrap().unbind_from_tree(cx, context);
+        self.update_style_block(cx);
+    }
+
+    fn attribute_mutated(
+        &self,
+        cx: &mut JSContext,
+        attr: AttrRef<'_>,
+        mutation: AttributeMutation,
+    ) {
+        self.super_type().unwrap().attribute_mutated(cx, attr, mutation);
+        if attr.name() == "type" {
+            self.update_style_block(cx);
+        }
+    }
+}
