+/// The geometry of an SVG shape in its own user space, for `getBBox` and
+/// `getTotalLength`.
+///
+/// Resolved on demand from computed style rather than read off the painted
+/// tree: the tree does not record which DOM node each shape came from, and
+/// recomputing one shape is cheap next to keeping that mapping alive.
+///
+/// # Safety
+///
+/// Walks DOM parents to find the enclosing viewport, so it may only be called
+/// from the script thread with no layout workers running. `Layout::query_*`
+/// satisfies that.
+#[expect(unsafe_code)]
+pub(crate) unsafe fn svg_geometry(node: ServoLayoutNode<'_>) -> Option<layout_api::SVGGeometry> {
+    // Percentage geometry resolves against the nearest viewport, so the basis
+    // has to come from the enclosing `<svg>`, not from this element.
+    let basis = unsafe { enclosing_viewport_basis(node) }?;
+    let (bounds, total_length) = unsafe { bounds_of(node, basis) }?;
+    Some(layout_api::SVGGeometry {
+        x: bounds.x0 as f32,
+        y: bounds.y0 as f32,
+        width: bounds.width() as f32,
+        height: bounds.height() as f32,
+        total_length: total_length as f32,
+    })
+}
+
+/// The union of a subtree's geometry, in `node`'s own user space, and the path
+/// length of `node` itself.
+///
+/// A container has no geometry of its own; `getBBox` on it is the union of its
+/// children's boxes, each mapped through that child's transform. Returning an
+/// empty rect instead would be silently wrong for the commonest case in real
+/// content, a shape wrapped in a `<g>`.
+///
+/// # Safety
+///
+/// As [`svg_geometry`].
+#[expect(unsafe_code)]
+unsafe fn bounds_of(
+    node: ServoLayoutNode<'_>,
+    basis: super::paint::PercentageBasis,
+) -> Option<(kurbo::Rect, f64)> {
+    use kurbo::Shape as _;
+    use layout_api::{LayoutElement as _, LayoutNode as _};
+
+    let element = node.as_element()?;
+    let style = tree::primary_style(element)?;
+
+    if let Some(path) = super::resolve::shape(element, &style, basis) {
+        // `getTotalLength` is only defined on geometry elements, but the
+        // perimeter of any shape is well defined, so it is always reported.
+        return Some((path.bounding_box(), path.perimeter(0.01)));
+    }
+
+    let mut union: Option<kurbo::Rect> = None;
+    for child in node.dom_children() {
+        let Some((child_bounds, _)) = (unsafe { bounds_of(child, basis) }) else {
+            continue;
+        };
+        // Each child's box is reported in the child's space; bring it into
+        // this element's by its own transform.
+        let Some(child_element) = child.as_element() else {
+            continue;
+        };
+        let Some(child_style) = tree::primary_style(child_element) else {
+            continue;
+        };
+        let transformed = (super::resolve::transform(child_element, &child_style, basis) *
+            child_bounds.to_path(0.01))
+        .bounding_box();
+        union = Some(match union {
+            Some(existing) => existing.union(transformed),
+            None => transformed,
+        });
+    }
+    union.map(|bounds| (bounds, 0.))
+}
+
+/// The percentage basis of the `<svg>` viewport enclosing `node`.
+///
+/// # Safety
+///
+/// As [`svg_geometry`].
+#[expect(unsafe_code)]
+unsafe fn enclosing_viewport_basis(
+    node: ServoLayoutNode<'_>,
+) -> Option<super::paint::PercentageBasis> {
+    use layout_api::{LayoutElementType, LayoutNode as _, LayoutNodeType};
+
+    use crate::dom::NodeExt as _;
+
+    // `getBBox` is defined on the `<svg>` element too, and there the viewport
+    // it establishes is its own.
+    let mut ancestor = Some(node);
+    while let Some(current) = ancestor {
+        let Some(element) = current.as_element() else {
+            // A Document, which `type_id` panics on. Nothing above it can be
+            // an SVG viewport.
+            break;
+        };
+        if current.type_id() == Some(LayoutNodeType::Element(LayoutElementType::SVGSVGElement)) {
+            let svg_data = current.as_svg()?;
+            let viewport = SVGViewport::new(
+                svg_data.view_box.map(|value| &**value),
+                svg_data.preserve_aspect_ratio.map(|value| &**value),
+            );
+            // Inside a viewBox, percentages resolve against it. Without one
+            // the CSS box decides, and the used size is not available from a
+            // script query, so fall back to the attribute-declared size.
+            let (width, height) = match viewport.view_box {
+                Some(view_box) => (view_box.width as f64, view_box.height as f64),
+                None => (
+                    attribute_length(element, &local_name!("width")),
+                    attribute_length(element, &local_name!("height")),
+                ),
+            };
+            return Some(super::paint::PercentageBasis::for_viewport(width, height));
+        }
+        ancestor = unsafe { current.dangerous_dom_parent() };
+    }
+    None
+}
+
+fn attribute_length(element: script::layout_dom::ServoLayoutElement<'_>, name: &LocalName) -> f64 {
+    use layout_api::LayoutElement as _;
+
+    element
+        .attribute_as_str(&ns!(), name)
+        .and_then(|value| {
+            let mut parser = super::number::NumberListParser::new(value);
+            parser.next_number()
+        })
+        .unwrap_or(0.) as f64
+}
