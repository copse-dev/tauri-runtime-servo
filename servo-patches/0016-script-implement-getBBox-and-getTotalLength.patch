+impl SVGGeometryElementMethods<crate::DomTypeHolder> for SVGGeometryElement {
+    /// <https://svgwg.org/svg2-draft/types.html#__svg__SVGGeometryElement__getTotalLength>
+    ///
+    /// The path's length in user units, already renormalized by `pathLength`
+    /// where present — which is the whole point of that attribute, so
+    /// reporting the raw length would contradict what the dash pattern does.
+    ///
+    /// Returns 0 for elements with no geometry. With
+    /// `layout.svg.native.enabled` off, only direct children of the `<svg>`
+    /// resolve — see `getBBox`.
+    fn GetTotalLength(&self) -> Finite<f32> {
+        let node = self.upcast::<Node>();
+        let length = node
+            .owner_window()
+            .svg_geometry_query(node)
+            .map_or(0., |geometry| geometry.total_length);
+        Finite::wrap(if length.is_finite() { length } else { 0. })
+    }
+}
