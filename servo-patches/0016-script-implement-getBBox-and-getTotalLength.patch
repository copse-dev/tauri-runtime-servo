+impl SVGGraphicsElementMethods<crate::DomTypeHolder> for SVGGraphicsElement {
+    /// <https://svgwg.org/svg2-draft/types.html#__svg__SVGGraphicsElement__getBBox>
+    ///
+    /// The *object* bounding box: the geometry's extent in this element's own
+    /// user space, before its own `transform`, and excluding stroke, markers
+    /// and clipping. The options argument selects between those variants and
+    /// is not honoured yet — only the default (fill-only) box is computed, so
+    /// a non-default request returns the same box rather than a wrong one.
+    ///
+    /// Returns an empty rect for elements with no geometry. With
+    /// `layout.svg.native.enabled` off, only direct children of the `<svg>`
+    /// resolve: `svg > * { display: none }` gives them computed styles but
+    /// prunes the traversal below them, so anything inside a `<g>` reports an
+    /// empty box rather than a wrong one.
+    fn GetBBox(
+        &self,
+        cx: &mut js::context::JSContext,
+        _options: &SVGBoundingBoxOptions,
+    ) -> DomRoot<DOMRect> {
+        let window = self.upcast::<Node>().owner_window();
+        let geometry = window
+            .svg_geometry_query(self.upcast::<Node>())
+            .unwrap_or_default();
+        DOMRect::new(
+            cx,
+            window.upcast(),
+            geometry.x as f64,
+            geometry.y as f64,
+            geometry.width as f64,
+            geometry.height as f64,
+        )
+    }
+}
