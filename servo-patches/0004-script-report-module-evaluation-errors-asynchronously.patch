diff --git a/tests/wpt/tests/workers/modules/dedicated-worker-top-level-await.html b/tests/wpt/tests/workers/modules/dedicated-worker-top-level-await.html
new file mode 100644
index 0000000000000000000000000000000000000000..96d617b7f32cbc84813e055d0d3763516d968de7
--- /dev/null
+++ b/tests/wpt/tests/workers/modules/dedicated-worker-top-level-await.html
@@ -0,0 +1,53 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Top-level await in dedicated module workers</title>
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<script>
+function wait_for_worker_message(t, script, message) {
+  return new Promise((resolve, reject) => {
+    const worker = new Worker(`resources/${script}`, {type: 'module'});
+    t.add_cleanup(() => worker.terminate());
+    worker.onmessage = t.step_func(event => resolve(event.data));
+    worker.onerror = t.step_func(event => {
+      event.preventDefault();
+      reject(new Error(event.message));
+    });
+    if (message !== undefined) {
+      worker.postMessage(message);
+    }
+  });
+}
+
+promise_test(async t => {
+  const result = await wait_for_worker_message(
+      t, 'top-level-await-static-import-worker.js');
+  assert_equals(result, 'static import');
+}, 'Top-level await following a static import');
+
+promise_test(async t => {
+  const result = await wait_for_worker_message(
+      t, 'top-level-await-dynamic-import-worker.js');
+  assert_equals(result, 'dynamic import');
+}, 'Top-level await of a dynamic import');
+
+promise_test(async t => {
+  const result = await wait_for_worker_message(
+      t, 'top-level-await-message-worker.js', 'message');
+  assert_equals(result, 'message');
+}, 'A module worker can receive a message while top-level await is pending');
+
+promise_test(async t => {
+  const event = await new Promise(resolve => {
+    const worker = new Worker(
+        'resources/top-level-await-rejection-worker.js', {type: 'module'});
+    t.add_cleanup(() => worker.terminate());
+    worker.onmessage = t.unreached_func('The worker must not post a message');
+    worker.onerror = t.step_func(error => {
+      error.preventDefault();
+      resolve(error);
+    });
+  });
+  assert_regexp_match(event.message, /top-level await rejection/);
+}, 'A rejected top-level await reports an error on the Worker');
+</script>
