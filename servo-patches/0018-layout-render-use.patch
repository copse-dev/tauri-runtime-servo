+/// `<use>`: renders the element its `href` names, as if it had been placed
+/// here.
+///
+/// <https://svgwg.org/svg2-draft/struct.html#UseElement>
+///
+/// Two departures from the spec, both deliberate. The referenced element keeps
+/// the computed style it has where it is *defined*, not where it is *used*, so
+/// inheritance through the `<use>` — most visibly `fill="currentColor"` on the
+/// `<use>` itself — does not reach it; doing that properly needs a second
+/// styling of the subtree in the use's inherited context, which is a shadow
+/// tree, which Servo's `SVGUseElement` does not build. And `<symbol>` is
+/// treated as a plain group, so a `viewBox` on it is ignored.
+fn build_use<'dom>(
+    node: ServoLayoutNode<'dom>,
+    element: ServoLayoutElement<'dom>,
+    style: &ComputedValues,
+    context: &BuildContext<'dom>,
+    use_depth: usize,
+) -> Option<SVGNode> {
+    if use_depth >= MAX_USE_DEPTH {
+        return None;
+    }
+    let href = element
+        .attribute_as_str(&ns!(), &local_name!("href"))
+        .or_else(|| element.attribute_as_str(&ns!(xlink), &local_name!("href")))?;
+    let target = context.paint_servers.element(href)?;
+    // A `<use>` may not reference itself, directly or through its own subtree.
+    if target.opaque() == node.opaque() {
+        return None;
+    }
+    let target_element = target.as_element()?;
+    let target_style = primary_style(target_element)?;
+
+    let basis = context.basis;
+    // `x` and `y` are an extra translation on top of the use's own transform.
+    let x = attribute_number(element, &local_name!("x"));
+    let y = attribute_number(element, &local_name!("y"));
+    let transform =
+        resolve::transform(element, style, basis) * kurbo::Affine::translate((x, y));
+
+    let opacity = resolve::opacity(style);
+    if opacity == 0. {
+        return None;
+    }
+
+    // The referenced element is rendered as though it were a child here, so it
+    // is built at one greater depth and wrapped in the use's own transform.
+    let name = target_element.local_name();
+    let mut children = Vec::new();
+    if *name == local_name!("symbol") || *name == local_name!("svg") {
+        // `<symbol>` only renders through a `<use>`, so its children are
+        // walked directly rather than going through `build_node`, which
+        // deliberately refuses to render one.
+        append_children(target, context, use_depth + 1, &mut children);
+    } else if let Some(built) =
+        build_node(target, target_element, &target_style, context, use_depth + 1)
+    {
+        children.push(built);
+    }
+
+    (!children.is_empty()).then(|| {
+        SVGNode::Group(SVGGroup {
+            transform,
+            opacity,
+            clip: None,
+            children,
+        })
+    })
+}
+
+/// A bare number attribute, defaulting to 0 as SVG's geometry attributes do.
+fn attribute_number(element: ServoLayoutElement<'_>, name: &web_atoms::LocalName) -> f64 {
+    element
+        .attribute_as_str(&ns!(), name)
+        .and_then(|value| {
+            let mut parser = super::number::NumberListParser::new(value);
+            parser.next_number()
+        })
+        .unwrap_or(0.) as f64
+}
+
