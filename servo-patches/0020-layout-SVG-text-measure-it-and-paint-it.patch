+/// <https://svgwg.org/svg2-draft/text.html#InterfaceSVGTextContentElement>
+#[dom_struct]
+pub(crate) struct SVGTextContentElement {
+    svggraphicselement: SVGGraphicsElement,
+}
+
+impl SVGTextContentElement {
+    pub(crate) fn new_inherited_with_state(
+        state: ElementState,
+        tag_name: LocalName,
+        prefix: Option<Prefix>,
+        document: &Document,
+    ) -> SVGTextContentElement {
+        SVGTextContentElement {
+            svggraphicselement: SVGGraphicsElement::new_inherited_with_state(
+                state, tag_name, prefix, document,
+            ),
+        }
+    }
+}
+
+impl SVGTextContentElementMethods<crate::DomTypeHolder> for SVGTextContentElement {
+    /// <https://svgwg.org/svg2-draft/text.html#__svg__SVGTextContentElement__getComputedTextLength>
+    ///
+    /// The advance width of the element's text, shaped with the font the
+    /// cascade resolved. Returns 0 when there is no text, no usable font, or
+    /// when `layout.svg.native.enabled` is off — SVG text is only measured on
+    /// the native path.
+    fn GetComputedTextLength(&self) -> Finite<f32> {
+        let node = self.upcast::<Node>();
+        let length = node
+            .owner_window()
+            .svg_geometry_query(node)
+            .map_or(0., |geometry| geometry.text_length);
+        Finite::wrap(if length.is_finite() { length } else { 0. })
+    }
+}
+
+impl VirtualMethods for SVGTextContentElement {
+    fn super_type(&self) -> Option<&dyn VirtualMethods> {
+        Some(self.upcast::<SVGGraphicsElement>() as &dyn VirtualMethods)
+    }
+}
