+++ b/components/layout/svg/text.rs
@@ -0,0 +1,239 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Measuring and positioning `<text>`.
+//!
+//! Only what a single-line label needs: the element's own text shaped with the
+//! font the cascade resolved, positioned by `x`/`y` and `text-anchor`. No
+//! `textPath`, no per-glyph `x`/`y`/`rotate` lists, no bidi reordering across
+//! `<tspan>`s, no automatic wrapping — SVG text has none of the last one, but
+//! the others are real features this does not have.
+//!
+//! Even so it is worth having on its own: `getComputedTextLength` and
+//! `getBBox` on a `<text>` are what content measures labels with, and a
+//! library that cannot measure text cannot lay out a diagram. Returning zeros
+//! would be worse than throwing, because the caller would believe them.
+
+use fonts::{FontContext, FontRef, ShapingFlags, ShapingOptions};
+use layout_api::LayoutElement as _;
+use layout_api::LayoutNode as _;
+use script::layout_dom::{ServoLayoutElement, ServoLayoutNode};
+use style::properties::ComputedValues;
+use style::computed_values::text_anchor::T as TextAnchor;
+use unicode_script::Script;
+use web_atoms::{local_name, ns};
+
+use crate::flow::inline::text_transform::TextTransformationIterator;
+
+use super::paint::PercentageBasis;
+
+/// A shaped run of SVG text, in the element's own user space.
+pub(crate) struct MeasuredText {
+    /// The origin the glyphs are positioned from: the text's anchor point
+    /// after `text-anchor` has been applied.
+    pub origin: (f64, f64),
+    /// Total advance width in user units — what `getComputedTextLength`
+    /// reports.
+    pub advance: f64,
+    pub ascent: f64,
+    pub descent: f64,
+    pub font: FontRef,
+    pub font_size: f64,
+    /// Glyph ids with their x offsets from `origin`, ready to paint.
+    pub glyphs: Vec<(u32, f64)>,
+}
+
+impl MeasuredText {
+    /// The tight bounding box of the run, for `getBBox`.
+    pub(crate) fn bounds(&self) -> kurbo::Rect {
+        kurbo::Rect::new(
+            self.origin.0,
+            self.origin.1 - self.ascent,
+            self.origin.0 + self.advance,
+            self.origin.1 + self.descent,
+        )
+    }
+}
+
+/// Measures an SVG text element, or `None` when it has no text, no usable font
+/// or a zero font size.
+pub(crate) fn measure(
+    node: ServoLayoutNode<'_>,
+    element: ServoLayoutElement<'_>,
+    style: &ComputedValues,
+    font_context: &FontContext,
+    basis: PercentageBasis,
+) -> Option<MeasuredText> {
+    let text = text_content(node);
+    if text.is_empty() {
+        return None;
+    }
+    // `text-transform` applies to SVG text like any other, and reusing
+    // layout's iterator keeps the casing rules (including the locale-sensitive
+    // ones) identical to HTML text rather than approximating them here.
+    let mut transformed = String::with_capacity(text.len());
+    for iteration in TextTransformationIterator::new(&text, style, true, true) {
+        transformed.extend(iteration.characters());
+    }
+    let text = transformed;
+
+    let font_style = style.clone_font();
+    let font_size = font_style.font_size.computed_size().px() as f64;
+    if !(font_size > 0.) {
+        return None;
+    }
+    let font = font_context.font_group(font_style.clone()).first(font_context)?;
+
+    // The font-variant properties come from the cascade like any other text;
+    // SVG does not change how a run is shaped, only where it is placed.
+    let shaped = font.shape_text(
+        &text,
+        &ShapingOptions {
+            letter_spacing: None,
+            word_spacing: None,
+            script: Script::Common,
+            language: Default::default(),
+            ligatures: font_style.font_variant_ligatures,
+            numeric: font_style.font_variant_numeric,
+            east_asian: font_style.font_variant_east_asian,
+            feature_settings: font_style.font_feature_settings.clone(),
+            position: font_style.font_variant_position,
+            alternates: Default::default(),
+            flags: ShapingFlags::empty(),
+        },
+    );
+    // Sum the advances rather than asking for a total: `total_advance` is on
+    // the slice type, and walking the glyphs is needed anyway to position
+    // them for painting.
+    let mut glyphs = Vec::new();
+    let mut advance = 0f64;
+    for glyph in shaped.glyphs() {
+        glyphs.push((glyph.id(), advance));
+        advance += glyph.advance().to_f32_px() as f64;
+    }
+
+    // `x`/`y` place the text's anchor point; `text-anchor` decides which part
+    // of the run lands there. SVG's `text-anchor` maps onto stylo's
+    // `text-align` for `start`/`middle`/`end`.
+    let x = coordinate(element, &local_name!("x"), basis.width);
+    let y = coordinate(element, &local_name!("y"), basis.height);
+    let anchor_shift = match style.get_inherited_svg().text_anchor {
+        TextAnchor::Middle => -advance / 2.,
+        TextAnchor::End => -advance,
+        TextAnchor::Start => 0.,
+    };
+
+    let metrics = &font.metrics;
+    Some(MeasuredText {
+        origin: (x + anchor_shift, y),
+        advance,
+        ascent: metrics.ascent.to_f32_px() as f64,
+        descent: metrics.descent.to_f32_px() as f64,
+        font,
+        font_size,
+        glyphs,
+    })
+}
+
+/// The element's text, flattened from its descendants.
+///
+/// `<tspan>` children contribute their text but not their own positioning, so
+/// a multi-line label measures as one run. That is wrong for a `<tspan>` with
+/// its own `x`/`y`, and right for the far commoner case of a `<tspan>` used
+/// only to style part of a line.
+fn text_content(node: ServoLayoutNode<'_>) -> String {
+    let mut out = String::new();
+    collect(node, &mut out);
+    // SVG collapses whitespace like HTML's `normal` by default.
+    out.split_whitespace().collect::<Vec<_>>().join(" ")
+}
+
+fn collect(node: ServoLayoutNode<'_>, out: &mut String) {
+    for child in node.dom_children() {
+        if child.as_element().is_some() {
+            collect(child, out);
+        } else {
+            out.push_str(&child.text_content());
+        }
+    }
+}
+
+/// An `x`/`y` coordinate. Percentages resolve against the viewport, as
+/// everywhere else in SVG.
+fn coordinate(element: ServoLayoutElement<'_>, name: &web_atoms::LocalName, basis: f64) -> f64 {
+    element
+        .attribute_as_str(&ns!(), name)
+        .and_then(|value| {
+            let value = value.trim();
+            match value.strip_suffix('%') {
+                Some(number) => number.trim().parse::<f64>().ok().map(|n| n / 100. * basis),
+                None => {
+                    let mut parser = super::number::NumberListParser::new(value);
+                    parser.next_number().map(|n| n as f64)
+                },
+            }
+        })
+        .unwrap_or(0.)
+}
+
+impl std::fmt::Debug for MeasuredText {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("MeasuredText")
+            .field("origin", &self.origin)
+            .field("advance", &self.advance)
+            .field("glyphs", &self.glyphs.len())
+            .finish()
+    }
+}
+
+impl super::scene::PaintText for MeasuredText {
+    fn paint(
+        &self,
+        context: &mut vello_cpu::RenderContext,
+        resources: &mut vello_cpu::Resources,
+        paint: vello_cpu::PaintType,
+    ) {
+        let Ok(data_and_index) = self.font.font_data_and_index() else {
+            return;
+        };
+        // vello wants the raw font bytes; servo's Font hands them over as a
+        // blob plus a collection index.
+        let font = vello_cpu::peniko::FontData::new(
+            vello_cpu::peniko::Blob::new(std::sync::Arc::new(data_and_index.data.clone())),
+            data_and_index.index,
+        );
+        context.set_paint(paint);
+        context
+            .glyph_run(resources, &font)
+            .font_size(self.font_size as f32)
+            .fill_glyphs(self.glyphs.iter().map(|(id, offset)| vello_cpu::Glyph {
+                id: *id,
+                x: (self.origin.0 + offset) as f32,
+                y: self.origin.1 as f32,
+            }));
+    }
+
+    fn bounds(&self) -> kurbo::Rect {
+        MeasuredText::bounds(self)
+    }
+}
+
+/// A cheap identity for the content hash: the same text at the same place with
+/// the same font produces the same key.
+pub(crate) fn hash_key(measured: &MeasuredText) -> u64 {
+    use std::hash::{Hash as _, Hasher as _};
+
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    measured.origin.0.to_bits().hash(&mut hasher);
+    measured.origin.1.to_bits().hash(&mut hasher);
+    measured.advance.to_bits().hash(&mut hasher);
+    measured.font_size.to_bits().hash(&mut hasher);
+    measured.glyphs.len().hash(&mut hasher);
+    for (id, offset) in &measured.glyphs {
+        id.hash(&mut hasher);
+        offset.to_bits().hash(&mut hasher);
+    }
+    hasher.finish()
+}
