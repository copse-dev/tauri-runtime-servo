+
+//! Vertex-marker placement: where along a path each marker sits, which way it
+//! points, and the transform that puts a `<marker>`'s content there.
+//!
+//! Pure like [`super::geometry`], because this is where the subtlety lives:
+//! the angle at an interior vertex is the bisector of the incoming and
+//! outgoing directions, `auto-start-reverse` flips only the first marker, and
+//! the reference point has to be mapped through the marker's own viewBox
+//! before it can be aligned with the vertex. All of it is testable with plain
+//! numbers.
+//!
+//! <https://svgwg.org/svg2-draft/painting.html#Markers>
+
+use kurbo::{Affine, BezPath, PathEl, Point, Vec2};
+
+use super::viewbox::{PreserveAspectRatio, ViewBox};
+
+/// Which of the three marker properties a position belongs to.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) enum MarkerKind {
+    Start,
+    Mid,
+    End,
+}
+
+/// A vertex a marker may be placed on.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct MarkerPosition {
+    pub kind: MarkerKind,
+    pub point: Point,
+    /// Direction the marker points, in radians, already resolved per the
+    /// vertex's role — outgoing at the start, incoming at the end, the
+    /// bisector in between.
+    pub angle: f64,
+}
+
+/// The `orient` attribute.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub(crate) enum Orient {
+    /// A fixed angle in radians. The default is `0`.
+    Angle(f64),
+    #[default]
+    Auto,
+    /// `auto`, but the start marker is rotated a further 180° so an arrowhead
+    /// drawn pointing right can cap both ends of a line.
+    AutoStartReverse,
+}
+
+impl Orient {
+    /// Parses the attribute; an unrecognized value falls back to the default,
+    /// which for `orient` is the angle 0, not `auto`.
+    pub(crate) fn parse(value: &str) -> Self {
+        let value = value.trim();
+        match value {
+            "auto" => return Orient::Auto,
+            "auto-start-reverse" => return Orient::AutoStartReverse,
+            _ => {},
+        }
+        let number = value.strip_suffix("deg").map(str::trim).unwrap_or(value);
+        match number.parse::<f64>() {
+            Ok(degrees) => Orient::Angle(degrees.to_radians()),
+            Err(_) => Orient::Angle(0.),
+        }
+    }
+
+    fn resolve(&self, position: &MarkerPosition) -> f64 {
+        match self {
+            Orient::Angle(angle) => *angle,
+            Orient::Auto => position.angle,
+            Orient::AutoStartReverse => {
+                if position.kind == MarkerKind::Start {
+                    position.angle + std::f64::consts::PI
+                } else {
+                    position.angle
+                }
+            },
+        }
+    }
+}
+
+/// `markerUnits`.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub(crate) enum MarkerUnits {
+    /// Marker coordinates are multiples of the stroke width. The default.
+    #[default]
+    StrokeWidth,
+    UserSpaceOnUse,
+}
+
+impl MarkerUnits {
+    pub(crate) fn parse(value: &str) -> Self {
+        match value.trim() {
+            "userSpaceOnUse" => MarkerUnits::UserSpaceOnUse,
+            _ => MarkerUnits::StrokeWidth,
+        }
+    }
+}
+
+/// Everything from a `<marker>` element needed to place it.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct MarkerGeometry {
+    /// `markerWidth`/`markerHeight`; the spec default is 3×3.
+    pub width: f64,
+    pub height: f64,
+    /// `refX`/`refY`, in the marker content's own coordinates.
+    pub ref_x: f64,
+    pub ref_y: f64,
+    pub orient: Orient,
+    pub units: MarkerUnits,
+    pub view_box: Option<ViewBox>,
+    pub preserve_aspect_ratio: PreserveAspectRatio,
+}
+
+impl Default for MarkerGeometry {
+    fn default() -> Self {
+        Self {
+            width: 3.,
+            height: 3.,
+            ref_x: 0.,
+            ref_y: 0.,
+            orient: Orient::default(),
+            units: MarkerUnits::default(),
+            view_box: None,
+            preserve_aspect_ratio: PreserveAspectRatio::default(),
+        }
+    }
+}
+
+impl MarkerGeometry {
+    /// The transform placing this marker's content at `position`, and the
+    /// rectangle (in content coordinates) the content is clipped to.
+    ///
+    /// Returns `None` for a zero-area marker, which the spec says disables
+    /// rendering of the marker.
+    pub(crate) fn place(
+        &self,
+        position: &MarkerPosition,
+        stroke_width: f64,
+    ) -> Option<(Affine, kurbo::Rect)> {
+        if !(self.width > 0. && self.height > 0.) {
+            return None;
+        }
+        let scale = match self.units {
+            MarkerUnits::StrokeWidth => stroke_width,
+            MarkerUnits::UserSpaceOnUse => 1.,
+        };
+        if !(scale > 0.) {
+            return None;
+        }
+
+        // The marker's own little viewport: content coordinates map into a
+        // markerWidth × markerHeight box exactly as an <svg>'s viewBox maps
+        // into its CSS box.
+        let viewport = super::SVGViewport {
+            view_box: self.view_box,
+            preserve_aspect_ratio: self.preserve_aspect_ratio,
+        };
+        let content_to_viewport = viewport.transform(euclid::default::Size2D::new(
+            self.width as f32,
+            self.height as f32,
+        ));
+        let viewbox_transform = Affine::new([
+            content_to_viewport.m11 as f64,
+            content_to_viewport.m12 as f64,
+            content_to_viewport.m21 as f64,
+            content_to_viewport.m22 as f64,
+            content_to_viewport.m31 as f64,
+            content_to_viewport.m32 as f64,
+        ]);
+
+        // refX/refY are content coordinates; the point they name is what
+        // lands on the vertex, so map it into the viewport first.
+        let reference = viewbox_transform * Point::new(self.ref_x, self.ref_y);
+
+        let transform = Affine::translate(position.point.to_vec2()) *
+            Affine::rotate(self.orient.resolve(position)) *
+            Affine::scale(scale) *
+            Affine::translate(-reference.to_vec2()) *
+            viewbox_transform;
+
+        // Markers clip to their viewport by default. The clip is applied in
+        // content coordinates — the same space the children are built in — so
+        // it is the viewport rectangle pulled back through the viewBox
+        // mapping.
+        let viewport_rect = kurbo::Rect::new(0., 0., self.width, self.height);
+        let determinant = viewbox_transform.determinant();
+        let clip = if determinant.abs() > f64::EPSILON {
+            transform_rect_bounds(viewbox_transform.inverse(), viewport_rect)
+        } else {
+            viewport_rect
+        };
+
+        Some((transform, clip))
+    }
+}
+
+fn transform_rect_bounds(transform: Affine, rect: kurbo::Rect) -> kurbo::Rect {
+    transform.transform_rect_bbox(rect)
+}
+
+/// The marker vertices of a path, with resolved angles.
+///
+/// Directions come from segment tangents, so curves point along their true
+/// tangent at each end. A closed subpath folds its closing direction into the
+/// first vertex's angle, which is what makes the corner markers of a
+/// `<polygon>` bisect properly.
+///
+/// One knowing imprecision: paths that contained arcs were already flattened
+/// to cubics by [`super::geometry`], so each arc contributes phantom interior
+/// vertices and `marker-mid` fires on them. Fixing that means carrying vertex
+/// provenance through the flattening.
+pub(crate) fn positions(path: &BezPath) -> Vec<MarkerPosition> {
+    struct Vertex {
+        point: Point,
+        incoming: Option<Vec2>,
+        outgoing: Option<Vec2>,
+    }
+    let mut vertices: Vec<Vertex> = Vec::new();
+    let mut subpath_start_index: Option<usize> = None;
+    let mut current = Point::ZERO;
+
+    fn push(vertices: &mut Vec<Vertex>, point: Point, incoming: Option<Vec2>) {
+        vertices.push(Vertex {
+            point,
+            incoming,
+            outgoing: None,
+        });
+    }
+
+    for element in path.elements() {
+        match *element {
+            PathEl::MoveTo(point) => {
+                push(&mut vertices, point, None);
+                subpath_start_index = Some(vertices.len() - 1);
+                current = point;
+            },
+            PathEl::LineTo(point) => {
+                let direction = direction(current, point);
+                if let Some(last) = vertices.last_mut() {
+                    last.outgoing = last.outgoing.or(direction);
+                }
+                push(&mut vertices, point, direction);
+                current = point;
+            },
+            PathEl::QuadTo(control, point) => {
+                let out_direction = direction(current, control).or(direction(current, point));
+                let in_direction = direction(control, point).or(direction(current, point));
+                if let Some(last) = vertices.last_mut() {
+                    last.outgoing = last.outgoing.or(out_direction);
+                }
+                push(&mut vertices, point, in_direction);
+                current = point;
+            },
+            PathEl::CurveTo(control1, control2, point) => {
+                let out_direction = direction(current, control1)
+                    .or(direction(current, control2))
+                    .or(direction(current, point));
+                let in_direction = direction(control2, point)
+                    .or(direction(control1, point))
+                    .or(direction(current, point));
+                if let Some(last) = vertices.last_mut() {
+                    last.outgoing = last.outgoing.or(out_direction);
+                }
+                push(&mut vertices, point, in_direction);
+                current = point;
+            },
+            PathEl::ClosePath => {
+                if let Some(start_index) = subpath_start_index {
+                    let start_point = vertices[start_index].point;
+                    let closing = direction(current, start_point);
+                    if let Some(last) = vertices.last_mut() {
+                        last.outgoing = last.outgoing.or(closing);
+                    }
+                    // The closing segment arrives back at the first vertex, so
+                    // its direction becomes that vertex's incoming edge and
+                    // the start angle bisects like any interior corner.
+                    let vertex = &mut vertices[start_index];
+                    vertex.incoming = vertex.incoming.or(closing);
+                    current = start_point;
+                }
+            },
+        }
+    }
+
+    let last_index = vertices.len().saturating_sub(1);
+    vertices
+        .iter()
+        .enumerate()
+        .map(|(index, vertex)| {
+            let kind = if index == 0 {
+                MarkerKind::Start
+            } else if index == last_index {
+                MarkerKind::End
+            } else {
+                MarkerKind::Mid
+            };
+            MarkerPosition {
+                kind,
+                point: vertex.point,
+                angle: angle_for(vertex.incoming, vertex.outgoing),
+            }
+        })
+        .collect()
+}
+
+fn direction(from: Point, to: Point) -> Option<Vec2> {
+    let vector = to - from;
+    (vector.hypot() > 1e-12).then_some(vector)
+}
+
+/// <https://svgwg.org/svg2-draft/painting.html#OrientAttribute>: the bisector
+/// of the incoming and outgoing directions where both exist.
+fn angle_for(incoming: Option<Vec2>, outgoing: Option<Vec2>) -> f64 {
+    match (incoming, outgoing) {
+        (Some(inward), Some(outward)) => {
+            let sum = normalize(inward) + normalize(outward);
+            if sum.hypot() > 1e-9 {
+                sum.atan2()
+            } else {
+                // A perfect reversal has no bisector; the incoming direction
+                // is at least stable.
+                inward.atan2()
+            }
+        },
+        (Some(only), None) | (None, Some(only)) => only.atan2(),
+        (None, None) => 0.,
+    }
+}
+
+fn normalize(vector: Vec2) -> Vec2 {
+    vector / vector.hypot()
+}
+
+#[cfg(test)]
+mod test {
+    use std::f64::consts::{FRAC_PI_2, FRAC_PI_4, PI};
+
+    use kurbo::{Affine, Point};
+
+    use super::super::geometry;
+    use super::{
+        MarkerGeometry, MarkerKind, MarkerPosition, MarkerUnits, Orient, positions,
+    };
+
+    fn assert_close(a: f64, b: f64) {
+        assert!((a - b).abs() < 1e-9, "{a} vs {b}");
+    }
+
+    #[test]
+    fn a_line_has_a_start_and_an_end() {
+        let found = positions(&geometry::line(0., 0., 10., 0.));
+        assert_eq!(found.len(), 2);
+        assert_eq!(found[0].kind, MarkerKind::Start);
+        assert_eq!(found[1].kind, MarkerKind::End);
+        assert_eq!(found[0].point, Point::new(0., 0.));
+        assert_eq!(found[1].point, Point::new(10., 0.));
+        assert_close(found[0].angle, 0.);
+        assert_close(found[1].angle, 0.);
+    }
+
+    #[test]
+    fn interior_vertices_bisect() {
+        // Right then down: the corner bisects at 45°.
+        let path = geometry::polygon(&[(0., 0.), (10., 0.), (10., 10.)], false).expect("renders");
+        let found = positions(&path);
+        assert_eq!(found.len(), 3);
+        assert_eq!(found[1].kind, MarkerKind::Mid);
+        assert_close(found[1].angle, FRAC_PI_4);
+        // Endpoints take their single adjacent direction.
+        assert_close(found[0].angle, 0.);
+        assert_close(found[2].angle, FRAC_PI_2);
+    }
+
+    #[test]
+    fn closing_a_polygon_folds_into_the_first_vertex() {
+        // A square: with the closing edge (up the left side) folded in, the
+        // first corner bisects between "up" (incoming) and "right" (outgoing),
+        // i.e. -45°; without the fold it would read 0°.
+        let path =
+            geometry::polygon(&[(0., 0.), (10., 0.), (10., 10.), (0., 10.)], true).expect("renders");
+        let found = positions(&path);
+        assert_eq!(found.len(), 4);
+        assert_close(found[0].angle, -FRAC_PI_4);
+    }
+
+    #[test]
+    fn orient_parses_and_resolves() {
+        assert_eq!(Orient::parse("auto"), Orient::Auto);
+        assert_eq!(Orient::parse("auto-start-reverse"), Orient::AutoStartReverse);
+        assert_eq!(Orient::parse("90"), Orient::Angle(90f64.to_radians()));
+        assert_eq!(Orient::parse("45deg"), Orient::Angle(45f64.to_radians()));
+        // Junk is the 0 angle, not auto.
+        assert_eq!(Orient::parse("sideways"), Orient::Angle(0.));
+
+        let start = MarkerPosition {
+            kind: MarkerKind::Start,
+            point: Point::ZERO,
+            angle: FRAC_PI_2,
+        };
+        let end = MarkerPosition {
+            kind: MarkerKind::End,
+            point: Point::ZERO,
+            angle: FRAC_PI_2,
+        };
+        // auto-start-reverse flips the start marker only.
+        let orient = Orient::AutoStartReverse;
+        assert_close(orient.resolve(&start), FRAC_PI_2 + PI);
+        assert_close(orient.resolve(&end), FRAC_PI_2);
+    }
+
+    #[test]
+    fn placement_aligns_the_reference_point() {
+        // A 10×10 marker with its reference at its centre, placed unrotated:
+        // content (5,5) must land on the vertex.
+        let geometry = MarkerGeometry {
+            width: 10.,
+            height: 10.,
+            ref_x: 5.,
+            ref_y: 5.,
+            orient: Orient::Angle(0.),
+            units: MarkerUnits::UserSpaceOnUse,
+            ..Default::default()
+        };
+        let position = MarkerPosition {
+            kind: MarkerKind::End,
+            point: Point::new(100., 50.),
+            angle: 0.,
+        };
+        let (transform, clip) = geometry.place(&position, 1.).expect("renders");
+        assert_eq!(transform * Point::new(5., 5.), Point::new(100., 50.));
+        assert_eq!(clip, kurbo::Rect::new(0., 0., 10., 10.));
+    }
+
+    #[test]
+    fn stroke_width_units_scale_the_marker() {
+        let geometry = MarkerGeometry {
+            width: 4.,
+            height: 4.,
+            ..Default::default()
+        };
+        let position = MarkerPosition {
+            kind: MarkerKind::End,
+            point: Point::ZERO,
+            angle: 0.,
+        };
+        // At stroke-width 2, one marker unit is two user units.
+        let (transform, _) = geometry.place(&position, 2.).expect("renders");
+        assert_eq!(transform * Point::new(1., 0.), Point::new(2., 0.));
+        // A zero stroke width disables a strokeWidth-units marker outright.
+        assert!(geometry.place(&position, 0.).is_none());
+    }
+
+    #[test]
+    fn auto_rotates_the_content() {
+        let geometry = MarkerGeometry {
+            orient: Orient::Auto,
+            units: MarkerUnits::UserSpaceOnUse,
+            ..Default::default()
+        };
+        let position = MarkerPosition {
+            kind: MarkerKind::End,
+            point: Point::ZERO,
+            angle: FRAC_PI_2, // pointing straight down
+        };
+        let (transform, _) = geometry.place(&position, 1.).expect("renders");
+        // Content +x now points down (+y).
+        let mapped = transform * Point::new(1., 0.);
+        assert_close(mapped.x, 0.);
+        assert_close(mapped.y, 1.);
+    }
+
+    #[test]
+    fn a_view_box_maps_content_into_the_marker_viewport() {
+        use super::super::viewbox::ViewBox;
+
+        // Content drawn in a 0..20 box, shown in a 10×10 marker: halved, and
+        // refX/refY are content coordinates so (10,10) is the aligned point.
+        let geometry = MarkerGeometry {
+            width: 10.,
+            height: 10.,
+            ref_x: 10.,
+            ref_y: 10.,
+            units: MarkerUnits::UserSpaceOnUse,
+            view_box: ViewBox::parse("0 0 20 20"),
+            ..Default::default()
+        };
+        let position = MarkerPosition {
+            kind: MarkerKind::End,
+            point: Point::new(50., 50.),
+            angle: 0.,
+        };
+        let (transform, clip) = geometry.place(&position, 1.).expect("renders");
+        assert_eq!(transform * Point::new(10., 10.), Point::new(50., 50.));
+        // Content 20 units from the reference lands 10 user units away.
+        assert_eq!(transform * Point::new(30., 10.), Point::new(60., 50.));
+        // And the clip is the viewport pulled back into content space.
+        assert_eq!(clip, kurbo::Rect::new(0., 0., 20., 20.));
+        let _ = Affine::IDENTITY;
+    }
+}
