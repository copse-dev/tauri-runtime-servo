+
+/// The three vertex-marker references, resolved against the collected
+/// definitions. Indexed start, mid, end.
+pub(crate) fn markers<'dom>(
+    style: &ComputedValues,
+    paint_servers: &PaintServers<'dom>,
+) -> [Option<super::pservers::MarkerDef<'dom>>; 3] {
+    use style::values::generics::url::UrlOrNone;
+
+    let svg = style.get_inherited_svg();
+    let resolve_one = |value: &style::values::computed::url::UrlOrNone| match value {
+        UrlOrNone::None => None,
+        UrlOrNone::Url(url) => {
+            let text = match url {
+                ComputedUrl::Valid(url) => url.as_str(),
+                ComputedUrl::Invalid(text) => text.as_str(),
+            };
+            paint_servers.marker(text)
+        },
+    };
+    [
+        resolve_one(&svg.marker_start),
+        resolve_one(&svg.marker_mid),
+        resolve_one(&svg.marker_end),
+    ]
+}
