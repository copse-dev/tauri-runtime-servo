+//! Collecting `<linearGradient>`, `<radialGradient>` and `<clipPath>`
+//! definitions.
+//!
+//! A `fill="url(#id)"` has to find the element that id names, and layout has
+//! no document-wide id lookup — the same gap that stops `<use>` working. What
+//! it does have is the `<svg>` subtree, and a paint server is essentially
+//! always defined inside the `<svg>` that references it, so the whole subtree
+//! is scanned once per tree build and the results kept in a map.
+//!
+//! That is a deliberate narrowing of the spec, which allows a reference to any
+//! element in the document. A reference that escapes the `<svg>` resolves to
+//! nothing and the shape goes unpainted, which is visible, rather than being
+//! silently painted black.
+
+use std::collections::HashMap;
+
+use kurbo::Affine;
+use layout_api::LayoutElement as _;
+use layout_api::LayoutNode as _;
+use script::layout_dom::{ServoLayoutElement, ServoLayoutNode};
+use web_atoms::{LocalName, local_name, ns};
+
+use super::paint::{
+    Gradient, GradientGeometry, GradientStop, GradientUnits, SpreadMethod, decode_fragment,
+};
+use super::transform::parse_transform_list;
+use super::tree;
+
+/// The paint servers defined anywhere inside one `<svg>`, by id.
+pub(crate) struct PaintServers<'dom> {
+    gradients: HashMap<String, std::sync::Arc<Gradient>>,
+    /// `<clipPath>` nodes, resolved lazily: a clip path's geometry depends on
+    /// the percentage basis and, for `objectBoundingBox` units, on the shape
+    /// being clipped, so it cannot be baked at collection time. The nodes
+    /// borrow from the layout pass being walked, which is why this carries a
+    /// lifetime rather than owning them.
+    clip_paths: HashMap<String, ClipPathDef<'dom>>,
+    /// `href`/`xlink:href` on each gradient, resolved after collection so a
+    /// forward reference works.
+    gradient_hrefs: HashMap<String, String>,
+}
+
+impl Default for PaintServers<'_> {
+    fn default() -> Self {
+        Self {
+            gradients: HashMap::new(),
+            clip_paths: HashMap::new(),
+            gradient_hrefs: HashMap::new(),
+        }
+    }
+}
+
+/// A collected `<clipPath>`.
+#[derive(Clone, Copy)]
+pub(crate) struct ClipPathDef<'dom> {
+    pub node: ServoLayoutNode<'dom>,
+    /// `clipPathUnits`; unlike gradients, this defaults to `userSpaceOnUse`.
+    pub units: GradientUnits,
+}
+
+impl<'dom> PaintServers<'dom> {
+    /// Scans `svg_root`'s subtree. Definitions are found wherever they sit,
+    /// not only in `<defs>`, which is what the spec requires.
+    pub(crate) fn collect(svg_root: ServoLayoutNode<'dom>) -> Self {
+        let mut servers = Self::default();
+        servers.visit(svg_root);
+        servers.resolve_inheritance();
+        servers
+    }
+
+    /// Applies `href`/`xlink:href` inheritance between gradients.
+    ///
+    /// A gradient may take its stops from another, which is how a palette of
+    /// shared stops is normally expressed. Only stops are inherited here;
+    /// inheriting the geometry attributes as well would need to distinguish
+    /// "absent" from "set to the default", which the collector does not track.
+    fn resolve_inheritance(&mut self) {
+        let inherited: Vec<(String, Vec<GradientStop>)> = self
+            .gradient_hrefs
+            .iter()
+            .filter_map(|(id, href)| {
+                // Only a gradient with no stops of its own inherits.
+                if !self.gradients.get(id)?.stops.is_empty() {
+                    return None;
+                }
+                let stops = self.inherited_stops(href, 0)?;
+                Some((id.clone(), stops))
+            })
+            .collect();
+        for (id, stops) in inherited {
+            if let Some(gradient) = self.gradients.get_mut(&id) {
+                std::sync::Arc::make_mut(gradient).stops = stops;
+            }
+        }
+    }
+
+    /// Follows a chain of `href`s to the first gradient that has stops.
+    ///
+    /// Bounded, because the chain can be circular and a cycle would otherwise
+    /// hang layout.
+    fn inherited_stops(&self, href: &str, depth: usize) -> Option<Vec<GradientStop>> {
+        const MAX_DEPTH: usize = 16;
+        if depth > MAX_DEPTH {
+            return None;
+        }
+        let fragment = decode_fragment(href.rsplit_once('#').map(|(_, id)| id)?);
+        let target = self.gradients.get(&fragment)?;
+        if !target.stops.is_empty() {
+            return Some(target.stops.clone());
+        }
+        let next = self.gradient_hrefs.get(&fragment)?;
+        self.inherited_stops(next, depth + 1)
+    }
+
+    fn visit(&mut self, node: ServoLayoutNode<'dom>) {
+        for child in node.dom_children() {
+            if let Some(element) = child.as_element() {
+                let name = element.local_name();
+                if *name == local_name!("linearGradient") || *name == local_name!("radialGradient")
+                {
+                    if let Some((id, gradient)) = parse_gradient(child, element) {
+                        // `href` wins over the legacy `xlink:href` when both
+                        // are present.
+                        if let Some(href) = element
+                            .attribute_as_str(&ns!(), &local_name!("href"))
+                            .or_else(|| {
+                                element.attribute_as_str(&ns!(xlink), &local_name!("href"))
+                            })
+                        {
+                            self.gradient_hrefs.insert(id.clone(), href.to_owned());
+                        }
+                        self.gradients.insert(id, std::sync::Arc::new(gradient));
+                    }
+                } else if *name == local_name!("clipPath") &&
+                    let Some(id) = element.attribute_as_str(&ns!(), &local_name!("id"))
+                {
+                    let units =
+                        match element.attribute_as_str(&ns!(), &local_name!("clipPathUnits")) {
+                            Some("objectBoundingBox") => GradientUnits::ObjectBoundingBox,
+                            _ => GradientUnits::UserSpaceOnUse,
+                        };
+                    self.clip_paths
+                        .insert(id.to_owned(), ClipPathDef { node: child, units });
+                }
+            }
+            self.visit(child);
+        }
+    }
+
+    /// Resolves a computed `url(...)` paint reference.
+    ///
+    /// Computed URLs are absolutized against the document base, so only the
+    /// fragment is meaningful here — the same reduction the rasterization path
+    /// makes when it rewrites paint references into the serialized copy.
+    pub(crate) fn lookup(&self, url: &str) -> Option<std::sync::Arc<Gradient>> {
+        let fragment = url.rsplit_once('#').map(|(_, id)| id)?;
+        self.gradients.get(&decode_fragment(fragment)).cloned()
+    }
+
+    /// Resolves a `clip-path: url(...)` reference.
+    pub(crate) fn clip_path(&self, url: &str) -> Option<ClipPathDef<'dom>> {
+        let fragment = url.rsplit_once('#').map(|(_, id)| id)?;
+        self.clip_paths.get(&decode_fragment(fragment)).copied()
+    }
+
+    pub(crate) fn is_empty(&self) -> bool {
+        self.gradients.is_empty() && self.clip_paths.is_empty()
+    }
+}
+
+fn parse_gradient(
+    node: ServoLayoutNode<'_>,
+    element: ServoLayoutElement<'_>,
+) -> Option<(String, Gradient)> {
+    let id = element.attribute_as_str(&ns!(), &local_name!("id"))?.to_owned();
+    let units = match element.attribute_as_str(&ns!(), &local_name!("gradientUnits")) {
+        Some("userSpaceOnUse") => GradientUnits::UserSpaceOnUse,
+        _ => GradientUnits::ObjectBoundingBox,
+    };
+    let spread = match element.attribute_as_str(&ns!(), &local_name!("spreadMethod")) {
