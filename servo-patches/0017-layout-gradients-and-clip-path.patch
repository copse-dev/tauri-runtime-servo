+/// The transform taking `objectBoundingBox` coordinates — fractions of the
+/// shape's bounds — into user space.
+///
+/// A shape with no extent in one axis makes the mapping degenerate, and the
+/// spec says the element is then not rendered, so this returns `None` rather
+/// than a collapsed transform.
+pub(crate) fn bounding_box_transform(bounds: kurbo::Rect) -> Option<Affine> {
+    (bounds.width() > 0. && bounds.height() > 0.).then(|| {
+        Affine::translate((bounds.x0, bounds.y0)) * Affine::scale_non_uniform(
+            bounds.width(),
+            bounds.height(),
+        )
+    })
 }
 
