+/// Validates stops per
+/// <https://svgwg.org/svg2-draft/pservers.html#GradientStops>.
+///
+/// Offsets are clamped to 0..=1 and forced non-decreasing — a stop may not
+/// precede its predecessor, and one that tries is snapped forward. Returns
+/// `None` for no stops at all, which the spec says renders as `none`; a single
+/// stop is left alone for the caller to treat as a solid colour.
+pub(crate) fn normalize_stops(stops: &[GradientStop]) -> Option<Vec<GradientStop>> {
+    if stops.is_empty() {
+        return None;
+    }
+    let mut previous = 0f32;
+    Some(
+        stops
+            .iter()
+            .map(|stop| {
+                let offset = if stop.offset.is_finite() {
+                    stop.offset.clamp(0., 1.).max(previous)
+                } else {
+                    previous
+                };
+                previous = offset;
+                GradientStop {
+                    offset,
+                    color: stop.color,
+                }
+            })
+            .collect(),
+    )
+}
