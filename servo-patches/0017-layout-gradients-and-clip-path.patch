+        Some(number) => number.trim().parse::<f64>().ok().map(|n| n / 100.),
+        None => value.parse::<f64>().ok(),
+    }
+}
+
+fn collect_stops(gradient: ServoLayoutNode<'_>) -> Vec<GradientStop> {
+    let mut stops = Vec::new();
+    for child in gradient.dom_children() {
+        let Some(element) = child.as_element() else {
+            continue;
+        };
+        if *element.local_name() != local_name!("stop") {
+            continue;
+        }
+        // `stop-color` and `stop-opacity` are CSS properties, so they come
+        // from the cascade and honour stylesheet rules; `offset` is not.
+        let Some(style) = tree::primary_style(element) else {
+            continue;
+        };
+        let svg = style.get_svg();
+        // `stop-color: currentColor` resolves against the stop's own `color`.
+        let current_color = style.get_inherited_text().clone_color();
+        let color = svg.stop_color.resolve_to_absolute(&current_color);
+        let opacity = svg.stop_opacity;
+        let offset = element
+            .attribute_as_str(&ns!(), &local_name!("offset"))
+            .and_then(parse_coordinate)
+            .unwrap_or(0.) as f32;
+        stops.push(GradientStop {
+            offset,
+            color: super::resolve::to_rgba(&color).multiply_alpha(opacity),
+        });
+    }
+    stops
+}
