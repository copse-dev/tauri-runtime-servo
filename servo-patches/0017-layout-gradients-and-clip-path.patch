+            y1: number(&local_name!("y1"), 0.),
+            x2: number(&local_name!("x2"), 1.),
+            y2: number(&local_name!("y2"), 0.),
+        }
+    } else {
+        let cx = number(&local_name!("cx"), 0.5);
+        let cy = number(&local_name!("cy"), 0.5);
+        let r = number(&local_name!("r"), 0.5);
