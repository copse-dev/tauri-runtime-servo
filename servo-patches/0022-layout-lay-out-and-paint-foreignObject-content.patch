+/// A `<foreignObject>`'s rectangle, from the same geometry properties
+/// `<image>` uses.
+pub(crate) fn foreign_object_rect(
+    style: &ComputedValues,
+    basis: PercentageBasis,
+) -> kurbo::Rect {
+    let svg = style.get_svg();
+    let position = style.get_position();
+    let x = resolve(&svg.x, basis.width);
+    let y = resolve(&svg.y, basis.height);
+    let width = resolve_size(&position.width, basis.width);
+    let height = resolve_size(&position.height, basis.height);
+    kurbo::Rect::new(x, y, x + width, y + height)
+}
