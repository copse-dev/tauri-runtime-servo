+//! `<foreignObject>`: HTML laid out inside an SVG.
+//!
+//! This is the direction the plan calls the inverse hinge. Everything else in
+//! this module renders SVG into a pixmap with vello; foreign content cannot go
+//! there, because painting HTML means the display list, not a rasterizer.
+//!
+//! The seam that makes it possible already exists: a replaced box may carry an
+//! inner [`IndependentFormattingContext`] — the mechanism `<video controls>`
+//! uses for its widget — whose fragments are appended to the replaced
+//! element's own. So each `<foreignObject>` becomes one of those, laid out
+//! against its declared width and height, and its fragments are wrapped in a
+//! `PositioningFragment` placed at the rectangle the SVG transform chain maps
+//! it to. The content then paints through the display list like any other
+//! HTML, above the SVG image.
+//!
+//! Two consequences of painting above rather than within:
+//!
+//! * SVG drawn *after* a `<foreignObject>` still paints beneath it. Correct
+//!   z-order would need the SVG image split at each foreign object.
+//! * Only the translation and scale of the transform chain place the content.
+//!   A rotated or skewed `<foreignObject>` is positioned by the same rectangle
+//!   its untransformed self would occupy, so it will be in the right place but
+//!   not turned. Rotating foreign content needs a transform on the fragment.
+//!
+//! Both are recorded rather than hidden: they are visible, not silent.
+
+use app_units::Au;
+use layout_api::LayoutElement as _;
+use layout_api::LayoutNode as _;
+use script::layout_dom::ServoLayoutNode;
+use style::properties::ComputedValues;
+use servo_arc::Arc as ServoArc;
+use web_atoms::local_name;
+
+use super::paint::PercentageBasis;
+use crate::PropagatedBoxTreeData;
+use crate::cell::ArcRefCell;
+use crate::context::LayoutContext;
+use crate::dom_traversal::{NodeAndStyleInfo, NonReplacedContents};
+use crate::flow::BlockFormattingContext;
+use crate::formatting_contexts::{
+    IndependentFormattingContext, IndependentFormattingContextContents,
+};
+use crate::layout_box_base::LayoutBoxBase;
+
+/// One `<foreignObject>`, ready to lay out.
+pub(crate) struct ForeignObject {
+    pub context: ArcRefCell<IndependentFormattingContext>,
+    /// The element's rectangle in SVG user space, before the viewport
+    /// transform.
+    pub rect: kurbo::Rect,
+    /// The accumulated transform from the element up to the SVG viewport.
+    pub transform: kurbo::Affine,
+    pub style: ServoArc<ComputedValues>,
+}
+
+/// Finds every `<foreignObject>` in the subtree and builds a formatting
+/// context for each one's children.
+pub(crate) fn collect(
+    svg_root: ServoLayoutNode<'_>,
+    context: &LayoutContext,
+    basis: PercentageBasis,
+    propagated_data: PropagatedBoxTreeData,
+) -> Vec<ForeignObject> {
+    let mut found = Vec::new();
+    visit(
+        svg_root,
+        context,
+        basis,
+        propagated_data,
+        kurbo::Affine::IDENTITY,
+        &mut found,
+    );
+    found
+}
+
+fn visit(
+    node: ServoLayoutNode<'_>,
+    context: &LayoutContext,
+    basis: PercentageBasis,
+    propagated_data: PropagatedBoxTreeData,
+    transform: kurbo::Affine,
+    found: &mut Vec<ForeignObject>,
+) {
+    for child in node.dom_children() {
+        let Some(element) = child.as_element() else {
+            continue;
+        };
+        let Some(style) = super::tree::primary_style(element) else {
+            continue;
+        };
+        let transform = transform * super::resolve::transform(element, &style, basis);
+
+        if *element.local_name() == local_name!("foreignObject") {
+            if let Some(foreign) = build(child, &style, context, basis, propagated_data, transform)
+            {
+                found.push(foreign);
+            }
+            // Foreign content is not SVG; nothing inside is walked again.
+            continue;
+        }
+        visit(child, context, basis, propagated_data, transform, found);
+    }
+}
+
+fn build(
+    node: ServoLayoutNode<'_>,
+    style: &ServoArc<ComputedValues>,
+    context: &LayoutContext,
+    basis: PercentageBasis,
+    propagated_data: PropagatedBoxTreeData,
+    transform: kurbo::Affine,
+) -> Option<ForeignObject> {
+    let rect = super::resolve::foreign_object_rect(style, basis);
+    if !(rect.width() > 0. && rect.height() > 0.) {
+        // A zero-sized foreignObject is not rendered, per spec.
+        return None;
+    }
+
+    let info = NodeAndStyleInfo::new(node, style.clone());
+    let contents = IndependentFormattingContextContents::Flow(BlockFormattingContext::construct(
+        context,
+        &info,
+        NonReplacedContents::OfElement,
+        propagated_data,
+        false, /* is_list_item */
+    ));
+    let base = LayoutBoxBase::new((&info).into(), style.clone());
+    Some(ForeignObject {
+        context: ArcRefCell::new(IndependentFormattingContext::new(
+            base,
+            contents,
+            propagated_data,
+        )),
+        rect,
+        transform,
+        style: style.clone(),
+    })
+}
+
+/// The size to lay a foreign object's content against, in CSS pixels.
+pub(crate) fn content_size(foreign: &ForeignObject, scale: f64) -> (Au, Au) {
+    (
+        Au::from_f64_px(foreign.rect.width() * scale),
+        Au::from_f64_px(foreign.rect.height() * scale),
+    )
+}
