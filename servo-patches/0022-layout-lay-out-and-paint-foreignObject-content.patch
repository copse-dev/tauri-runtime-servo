+
+/// Lays out each `<foreignObject>`'s content and places it in the SVG's box.
+///
+/// The content is laid out against the foreign object's own width and height
+/// in device-independent pixels, then wrapped in an anonymous
+/// `PositioningFragment` at the rectangle the viewport transform maps it to.
+/// From there it paints through the display list like any other HTML.
+fn layout_foreign_objects(
+    layout_context: &LayoutContext,
+    native: &NativeSVG,
+    viewport_transform: euclid::default::Transform2D<f32>,
+    svg_rect: PhysicalRect<Au>,
+) -> Vec<Fragment> {
+    use crate::fragment_tree::PositioningFragment;
+    use style::Zero as _;
+
+    use crate::geom::{PhysicalPoint, PhysicalSize};
+    use crate::positioned::PositioningContext;
+    use crate::sizing::{LazySize, SizeConstraint};
+    use crate::{ContainingBlock, ContainingBlockSize};
+
+    if native.foreign_objects.is_empty() {
         return vec![];
-    };
+    }
+    let to_viewport = kurbo::Affine::new([
+        viewport_transform.m11 as f64,
+        viewport_transform.m12 as f64,
+        viewport_transform.m21 as f64,
+        viewport_transform.m22 as f64,
+        viewport_transform.m31 as f64,
+        viewport_transform.m32 as f64,
+    ]);
+
+    let mut fragments = Vec::new();
+    for foreign in &native.foreign_objects {
+        // Where the element's rectangle lands in the SVG's content box, and
+        // how much the chain scales it. Rotation and skew are not applied to
+        // the content; see the module docs.
+        let mapped = (to_viewport * foreign.transform).transform_rect_bbox(foreign.rect);
+        let scale = ((mapped.width() / foreign.rect.width()).abs()
+            + (mapped.height() / foreign.rect.height()).abs()) /
+            2.;
+        let (inline_size, block_size) = super::foreign::content_size(foreign, scale);
+        if inline_size <= Au::zero() || block_size <= Au::zero() {
+            continue;
+        }
 
-    vec![Fragment::Image(Arc::new(ImageFragment {
-        base,
-        clip,
-        image_key: Some(image_key),
-        showing_broken_image_icon: false,
-        url: None,
-    }))]
+        let containing_block = ContainingBlock {
+            size: ContainingBlockSize {
+                inline: inline_size,
+                block: SizeConstraint::Definite(block_size),
+            },
+            style: &foreign.style,
+        };
+        let mut positioning_context = PositioningContext::default();
+        let layout = foreign.context.borrow().layout(
+            layout_context,
+            &mut positioning_context,
+            &containing_block,
+            &containing_block,
+            None,
+            &LazySize::intrinsic(),
+        );
+
+        let origin = PhysicalPoint::new(
+            svg_rect.origin.x + Au::from_f64_px(mapped.x0),
+            svg_rect.origin.y + Au::from_f64_px(mapped.y0),
+        );
+        let content_rect = PhysicalRect::new(
+            origin,
+            PhysicalSize::new(inline_size, block_size),
+        );
+        // Per SVG 2 the foreignObject establishes the containing block for
+        // its absolutely positioned descendants, and that is also the only
+        // correct place to resolve them: hoisting leaves a placeholder in the
