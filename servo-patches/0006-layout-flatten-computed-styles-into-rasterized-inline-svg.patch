+/// Generates a stylesheet flattening each subtree element's computed SVG
+/// paint properties into rules keyed by the `data-servo-style-id` attributes
+/// that `SVGSVGElement` serialization stamped, walking the DOM subtree in the
+/// same preorder. Declarations are `!important` so they take precedence over
+/// presentation attributes and inline `style` in the serialized markup —
+/// computed values already reflect the full cascade. Elements the style
+/// system skipped (e.g. inside a `display: none` subtree) contribute no rule.
+fn collect_flattened_svg_style_rules(node: ServoLayoutNode<'_>) -> String {
+    fn visit(node: ServoLayoutNode<'_>, index: &mut u32, rules: &mut String) {
+        if node.as_element().is_none() {
+            return;
+        }
+        let id = *index;
+        *index += 1;
+        if let Some(style) = node
+            .as_element()
+            .and_then(|element| element.style_data())
+            .map(|style_data| style_data.element_data.borrow())
+            .and_then(|data| data.styles.get_primary().cloned())
+        {
+            append_flattened_svg_style_rule(id, &style, rules);
+        }
+        for child in node.dom_children() {
+            visit(child, index, rules);
+        }
+    }
+
+    let mut rules = String::new();
+    let mut index = 0;
+    visit(node, &mut index, &mut rules);
+    rules
+}
+
+fn append_flattened_svg_style_rule(id: u32, style: &ComputedValues, rules: &mut String) {
+    use std::fmt::Write as _;
+
+    let mut declarations = String::new();
+    let mut push = |name: &str, value: String| {
+        let _ = write!(declarations, "{name}:{value}!important;");
+    };
+
+    // Resolve `currentcolor` here rather than relying on the rasterizer:
+    // svgtypes parses the keyword case-sensitively as `currentColor`, so
+    // stylo's lowercase computed serialization would fail to parse, and the
+    // computed `color` is on hand anyway.
+    let color = style.clone_color().to_css_string();
+    let resolve_current_color = |paint_css: String| {
+        if paint_css == "currentcolor" {
+            color.clone()
+        } else {
+            paint_css
+        }
+    };
+
+    let svg = style.get_inherited_svg();
+    push("fill", resolve_current_color(svg.fill.to_css_string()));
+    push("fill-opacity", svg.fill_opacity.to_css_string());
+    push("fill-rule", svg.fill_rule.to_css_string());
+    push("stroke", resolve_current_color(svg.stroke.to_css_string()));
+    push("stroke-width", svg.stroke_width.to_css_string());
+    push("stroke-linecap", svg.stroke_linecap.to_css_string());
+    push("stroke-linejoin", svg.stroke_linejoin.to_css_string());
+    push("stroke-miterlimit", svg.stroke_miterlimit.to_css_string());
+    push("stroke-dasharray", svg.stroke_dasharray.to_css_string());
+    push("stroke-dashoffset", svg.stroke_dashoffset.to_css_string());
+    push("stroke-opacity", svg.stroke_opacity.to_css_string());
+    push("color", color.clone());
+    push("opacity", style.get_effects().opacity.to_string());
+    push(
+        "visibility",
+        style.get_inherited_box().visibility.to_css_string(),
+    );
+    // `display` is deliberately not flattened: Servo computes `display: none`
+    // for elements inside a replaced `<svg>` subtree (they generate no boxes),
+    // which says nothing about author intent — emitting it would hide every
+    // shape. CSS-driven `display: none` on SVG descendants therefore still
+    // isn't honored by rasterization; `visibility: hidden` is.
+
+    let _ = write!(rules, "[data-servo-style-id=\"{id}\"]{{{declarations}}}");
+}
+
+/// Escapes text for embedding in XML character data, so CSS values that
+/// happen to contain markup-significant characters can't derail parsing.
+fn escape_xml_text(text: &str) -> String {
+    let mut escaped = String::with_capacity(text.len());
+    for character in text.chars() {
+        match character {
+            '&' => escaped.push_str("&amp;"),
+            '<' => escaped.push_str("&lt;"),
+            '>' => escaped.push_str("&gt;"),
+            _ => escaped.push(character),
+        }
+    }
+    escaped
+}
+
 /// Rewrites a serialized inline-SVG data URL so its root carries the
-/// element's computed CSS `color` as a presentation attribute, unless the
-/// markup already declares one. Returns `None` (leaving the source untouched)
-/// for anything unexpected.
-fn inject_computed_color_into_svg_source(source: &ServoUrl, color_css: &str) -> Option<ServoUrl> {
+/// element's computed CSS `color` as a presentation attribute (unless the
+/// markup already declares one) and, when `flattened_rules` is non-empty, a
+/// `<style>` child carrying the subtree's flattened computed styles. Returns
+/// `None` (leaving the source untouched) for anything unexpected.
+fn inject_computed_styles_into_svg_source(
+    source: &ServoUrl,
+    color_css: &str,
+    flattened_rules: &str,
+) -> Option<ServoUrl> {
     use base64::Engine as _;
 
     let base64_payload = source
@@ -835,6 +942,7 @@ fn inject_computed_color_into_svg_source(source: &ServoUrl, color_css: &str) ->
     }
     let tag_end = tag_start + xml[tag_start..].find('>')?;
     let open_tag = &xml[tag_start..tag_end];
+    let root_is_self_closing = open_tag.ends_with('/');
 
     // A `color` attribute already present on the root wins. The whitespace
     // check keeps `stop-color=` and friends from matching.
@@ -844,17 +952,31 @@ fn inject_computed_color_into_svg_source(source: &ServoUrl, color_css: &str) ->
             .next_back()
             .is_some_and(|preceding| preceding.is_ascii_whitespace())
     });
-    if has_color_attribute {
+
+    let inject_color = !has_color_attribute &&
+        // Attribute values are CSS color serializations like `rgb(1, 2, 3)`;
+        // refuse anything that could break out of the quoted attribute.
+        !color_css.contains(['"', '<', '>', '&']);
+
+    // A self-closing root has no children to style (and nowhere to put the
+    // stylesheet); the root `<svg>` container itself paints nothing.
+    let inject_rules = !flattened_rules.is_empty() && !root_is_self_closing;
+
+    if !inject_color && !inject_rules {
         return None;
     }
 
-    // Attribute values are CSS color serializations like `rgb(1, 2, 3)`;
-    // refuse anything that could break out of the quoted attribute.
-    if color_css.contains(['"', '<', '>', '&']) {
-        return None;
+    // Insert at the later position first so the earlier one stays valid.
+    if inject_rules {
+        xml.insert_str(
+            tag_end + 1,
+            &format!("<style>{}</style>", escape_xml_text(flattened_rules)),
+        );
+    }
+    if inject_color {
+        xml.insert_str(after_name, &format!(" color=\"{color_css}\""));
     }
 
-    xml.insert_str(after_name, &format!(" color=\"{color_css}\""));
     let reencoded = base64::engine::general_purpose::STANDARD.encode(xml);
     ServoUrl::parse(&format!("data:image/svg+xml;base64,{reencoded}")).ok()
 }
