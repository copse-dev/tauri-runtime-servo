diff --git a/components/layout/svg/integration.rs b/components/layout/svg/integration.rs
index 7facf1c2f1f1fc8acb376916c88e8797c6fea2b9..dac5d60a8fd06d00d4dcd640d891dee473725059 100644
--- a/components/layout/svg/integration.rs
+++ b/components/layout/svg/integration.rs
@@ -215,6 +215,32 @@ unsafe fn bounds_of(
     let style = tree::primary_style(element)?;
 
     let name = element.local_name();
+    // `getBBox` on a `<foreignObject>` is defined as its declared rectangle,
+    // not as a measurement of the content inside it, so this is the spec
+    // answer rather than a placeholder for one.
+    if *name == local_name!("foreignObject") {
+        let svg = style.get_svg();
+        let position = style.get_position();
+        let resolve = |length: &style::values::computed::LengthPercentage, basis: f64| {
+            length
+                .resolve(style::values::computed::Length::new(basis as f32))
+                .px() as f64
+        };
+        let size = |size: &style::values::generics::length::GenericSize<
+            style::values::generics::NonNegative<style::values::computed::LengthPercentage>,
+        >,
+                    basis: f64| match size {
+            style::values::generics::length::GenericSize::LengthPercentage(length) => {
+                resolve(&length.0, basis)
+            },
+            _ => 0.,
+        };
+        let x = resolve(&svg.x, basis.width);
+        let y = resolve(&svg.y, basis.height);
+        let width = size(&position.width, basis.width);
+        let height = size(&position.height, basis.height);
+        return Some((kurbo::Rect::new(x, y, x + width, y + height), 0., 0.));
+    }
     if *name == local_name!("text") || *name == local_name!("tspan") {
         let measured = super::text::measure(node, element, &style, font_context, basis)?;
         return Some((measured.bounds(), 0., measured.advance));
