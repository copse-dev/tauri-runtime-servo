+    /// <https://svgwg.org/svg2-draft/types.html#__svg__SVGGeometryElement__isPointInFill>
+    ///
+    /// The point is in the element's own user space, so no transform applies.
+    /// Honours `fill-rule`, which is the whole reason this is not a bounding
+    /// box test.
+    fn IsPointInFill(&self, point: &DOMPointInit) -> bool {
+        self.point_query(SVGPointQuery::InFill {
+            x: point.x as f32,
+            y: point.y as f32,
+        })
+        .is_some_and(|answer| matches!(answer, SVGPointAnswer::Contains(true)))
+    }
+
+    /// <https://svgwg.org/svg2-draft/types.html#__svg__SVGGeometryElement__isPointInStroke>
+    ///
+    /// Dashes are ignored: a dashed stroke is one region, not a row of them.
+    fn IsPointInStroke(&self, point: &DOMPointInit) -> bool {
+        self.point_query(SVGPointQuery::InStroke {
+            x: point.x as f32,
+            y: point.y as f32,
+        })
+        .is_some_and(|answer| matches!(answer, SVGPointAnswer::Contains(true)))
+    }
+
+    /// <https://svgwg.org/svg2-draft/types.html#__svg__SVGGeometryElement__getPointAtLength>
+    ///
+    /// Distances outside the path clamp to its ends. The distance is in user
+    /// units, not `pathLength` units — see `getTotalLength`.
+    fn GetPointAtLength(&self, cx: &mut js::context::JSContext, distance: Finite<f32>) -> DomRoot<DOMPoint> {
+        let (x, y) = match self.point_query(SVGPointQuery::AtLength(*distance)) {
+            Some(SVGPointAnswer::Point { x, y }) => (x as f64, y as f64),
+            _ => (0., 0.),
+        };
+        DOMPoint::new(cx, &self.owner_global(), x, y, 0., 1.)
+    }
+}
+
+impl SVGGeometryElement {
+    fn point_query(&self, query: SVGPointQuery) -> Option<SVGPointAnswer> {
+        let node = self.upcast::<Node>();
+        node.owner_window().svg_point_query(node, query)
+    }
 }
 
