diff --git a/components/layout/svg/hittest.rs b/components/layout/svg/hittest.rs
index 7c8e4a2daf43d243c7b47051ec52c48f9f65fb2b..5485e11c2be9e03dfc2d28fc8e1a8e1cd5e1f63a 100644
--- a/components/layout/svg/hittest.rs
+++ b/components/layout/svg/hittest.rs
@@ -214,6 +214,61 @@ fn to_kurbo_stroke(stroke: &Stroke) -> KurboStroke {
 
 const STROKE_TOLERANCE: f64 = 0.1;
 
+/// Whether `point` is inside `path`'s fill region, per `fill-rule`.
+///
+/// Backs `SVGGeometryElement.isPointInFill`, which is defined on the
+/// element's own coordinate system, so no transform is involved.
+pub(crate) fn point_in_fill(path: &BezPath, point: Point, rule: FillRule) -> bool {
+    contains_with_rule(path, point, rule)
+}
+
+/// Whether `point` is inside `path`'s stroke region.
+///
+/// Backs `SVGGeometryElement.isPointInStroke`. Dashes are ignored, as in
+/// [`hit_test`]: a dashed stroke is one region, not a row of them.
+pub(crate) fn point_in_stroke(path: &BezPath, point: Point, stroke: &Stroke) -> bool {
+    if stroke.width <= 0. {
+        return false;
+    }
+    kurbo::stroke(
+        path.iter(),
+        &to_kurbo_stroke(stroke),
+        &StrokeOpts::default(),
+        STROKE_TOLERANCE,
+    )
+    .contains(point)
+}
+
+/// The point `distance` along `path`, for `getPointAtLength`.
+///
+/// Distances outside the path clamp to its ends, which is what the spec asks
+/// for. Returns `None` only for a path with no segments at all.
+pub(crate) fn point_at_length(path: &BezPath, distance: f64) -> Option<Point> {
+    use kurbo::ParamCurve as _;
+    use kurbo::ParamCurveArclen as _;
+
+    let segments: Vec<_> = path.segments().collect();
+    let first = segments.first()?;
+    if distance <= 0. {
+        return Some(first.eval(0.));
+    }
+    let mut remaining = distance;
+    for segment in &segments {
+        let length = segment.arclen(ARCLEN_ACCURACY);
+        if remaining <= length {
+            // `inv_arclen` maps a distance along this segment back to its
+            // parameter, which is the whole reason to walk segment by segment
+            // rather than flattening the path.
+            return Some(segment.eval(segment.inv_arclen(remaining, ARCLEN_ACCURACY)));
+        }
+        remaining -= length;
+    }
+    // Past the end: clamp to the final point.
+    segments.last().map(|segment| segment.eval(1.))
+}
+
+const ARCLEN_ACCURACY: f64 = 0.01;
+
