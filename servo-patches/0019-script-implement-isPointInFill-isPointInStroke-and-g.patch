+/// Answers a point query against an SVG shape.
+///
+/// Like [`svg_geometry`], resolved on demand from computed style.
+///
+/// # Safety
+///
+/// As [`svg_geometry`].
+#[expect(unsafe_code)]
+pub(crate) unsafe fn svg_point_query(
+    node: ServoLayoutNode<'_>,
+    query: layout_api::SVGPointQuery,
+) -> Option<layout_api::SVGPointAnswer> {
+    use kurbo::Point;
+    use layout_api::{LayoutNode as _, SVGPointAnswer, SVGPointQuery};
+
+    use super::hittest;
+
+    let element = node.as_element()?;
+    let style = tree::primary_style(element)?;
+    let basis = unsafe { enclosing_viewport_basis(node) }?;
+    let path = super::resolve::shape(element, &style, basis)?;
+
+    Some(match query {
+        SVGPointQuery::InFill { x, y } => {
+            let current_color = style.get_inherited_text().clone_color();
+            // The paint servers are irrelevant to whether a point is inside,
+            // so an empty set is enough to get at the fill rule.
+            let (_, rule) = super::resolve::fill(
+                &style,
+                &current_color,
+                &super::pservers::PaintServers::default(),
+            );
+            SVGPointAnswer::Contains(hittest::point_in_fill(
+                &path,
+                Point::new(x as f64, y as f64),
+                rule,
+            ))
+        },
+        SVGPointQuery::InStroke { x, y } => {
+            let current_color = style.get_inherited_text().clone_color();
+            let stroke = super::resolve::stroke(
+                &style,
+                &current_color,
+                basis,
+                &super::pservers::PaintServers::default(),
+            );
+            SVGPointAnswer::Contains(hittest::point_in_stroke(
+                &path,
+                Point::new(x as f64, y as f64),
+                &stroke,
+            ))
+        },
+        SVGPointQuery::AtLength(distance) => {
+            let point = hittest::point_at_length(&path, distance as f64)?;
+            SVGPointAnswer::Point {
+                x: point.x as f32,
+                y: point.y as f32,
+            }
+        },
+    })
+}
