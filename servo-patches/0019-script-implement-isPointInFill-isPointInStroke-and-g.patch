+    #[test]
+    fn point_in_fill_and_stroke_are_independent_regions() {
+        use super::{point_in_fill, point_in_stroke};
+
+        let path = geometry::rect(0., 0., 10., 10., None, None).expect("renders");
+        let stroke = Stroke {
+            paint: Paint::Color(RED),
+            width: 4.,
+            ..Default::default()
+        };
+        // The centre is fill, not stroke.
+        assert!(point_in_fill(&path, Point::new(5., 5.), FillRule::NonZero));
+        assert!(!point_in_stroke(&path, Point::new(5., 5.), &stroke));
+        // Just outside the edge is stroke, not fill.
+        assert!(!point_in_fill(&path, Point::new(-1., 5.), FillRule::NonZero));
+        assert!(point_in_stroke(&path, Point::new(-1., 5.), &stroke));
+        // A zero-width stroke has no region.
+        assert!(!point_in_stroke(
+            &path,
+            Point::new(-1., 5.),
+            &Stroke {
+                width: 0.,
+                ..stroke.clone()
+            }
+        ));
+    }
+
+    #[test]
+    fn point_at_length_walks_the_path() {
+        use super::point_at_length;
+
+        // A 100-unit horizontal line.
+        let line = geometry::line(0., 5., 100., 5.);
+        assert_eq!(point_at_length(&line, 0.), Some(Point::new(0., 5.)));
+        assert_eq!(point_at_length(&line, 25.), Some(Point::new(25., 5.)));
+        assert_eq!(point_at_length(&line, 100.), Some(Point::new(100., 5.)));
+        // Out of range clamps to the ends rather than failing.
+        assert_eq!(point_at_length(&line, -10.), Some(Point::new(0., 5.)));
+        assert_eq!(point_at_length(&line, 500.), Some(Point::new(100., 5.)));
+
+        // Across a corner: 10 right then 10 down, so 15 is halfway down.
+        let corner = geometry::polygon(&[(0., 0.), (10., 0.), (10., 10.)], false).expect("renders");
+        let at = point_at_length(&corner, 15.).expect("on the path");
+        assert!((at.x - 10.).abs() < 1e-6 && (at.y - 5.).abs() < 1e-6, "got {at:?}");
+    }
