{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hello World Servo",
  "version": "0.1.0",
  "identifier": "com.tauri.servo.dev",
  "build": {
    "frontendDist": [
      "index.html"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Welcome to Tauri on Servo!",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
